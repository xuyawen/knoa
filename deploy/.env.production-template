# Knoa 生产环境变量
# ===== 使用方法 =====
# 1. 复制本文件为 deploy/.env（或项目根目录 .env）
# 2. 替换所有 change-me / TODO 占位符为真实值
# 3. 本文件已被 .gitignore 忽略，切勿将填入真实密钥的版本提交 git
#
# ===== 生成强随机值命令 =====
# POSTGRES_PASSWORD: openssl rand -hex 24
# JWT_SECRET:         openssl rand -hex 32
# ADMIN_PASSWORD:     用你记得住的强密码（含大小写+数字+符号，12位以上）

# ── 数据库口令（postgres/backup/backend 三方必须一致）──
POSTGRES_PASSWORD=change-me-random-24-hex-chars

# ── 前端访问地址（CORS + nginx server_name）──
# 项目不使用 HTTPS，仅走 HTTP。
# 无域名过渡期用 IP：http://8.134.14.177
PUBLIC_IP=8.134.14.177
CORS_ORIGINS=http://8.134.14.177

# ── TLS 选项 ──
# 项目已确定纯 HTTP，不做 TLS 终止（edge nginx 仅 80 端口反代）。
# 若将来要切 HTTPS，再补证书并把 nginx.conf / edge 端口映射恢复为 443。
TLS_MODE=http

# ── 反向代理 ──
# 生产走 nginx 反代（deploy/nginx/*.conf 会注入 X-Forwarded-For），
# 开启后登录限流按真实客户端 IP 计数；后端直连公网时务必保持 false，
# 否则攻击者可伪造 XFF 头绕过限流。
TRUST_PROXY=true
